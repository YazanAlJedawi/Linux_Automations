services:
  nginx:
    image: docker.io/library/nginx:alpine
    container_name: nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro,Z
      - ./nginx/certs:/etc/nginx/certs:ro,Z
    networks:
      - frontend

  webapp:
    build: ./app
    container_name: webapp
    environment:
      DB_HOST: "{{ hostvars['server2.local']['ansible_host'] }}"
      DB_NAME: gateway
      DB_USER: gateway
      DB_PASS: "{{ db_password }}"
    networks:
      - frontend
      - backend

  db:
    image: docker.io/postgres:16-alpine
    container_name: db_disabled
    networks:
      - backend

networks:
  frontend:
  backend: